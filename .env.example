# =============================
# Noogler container environment
# =============================

# --- Public container port (backend HTTP + WebSocket share this port) ---
PORT=3000
BACKEND_PORT=3000
WEBSOCKET_PORT=3000
LOG_LEVEL=info

# --- Internal Eliza agent connectivity inside container ---
ELIZA_PORT=7070
ELIZA_BASE_URL=http://127.0.0.1:7070
ELIZA_CHARACTER=characters/noogler.json

# --- Nosana inference configuration (required) ---
# Example: https://inference-api.nosana.ai/v1
NOSANA_BASE_URL=
NOSANA_MODEL=Qwen/Qwen3.5-27B-AWQ-4bit
NOSANA_API_KEY=

# --- Firebase Admin SDK credentials (required for memory persistence) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep literal \n escapes when set in Docker/Nosana env fields.
FIREBASE_PRIVATE_KEY=

# Optional existing backend compatibility settings.
GEMINI_MODEL=gemini-flash-latest
