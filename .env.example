# --- Backend ---
PORT=8080
BACKEND_PORT=8080
LOG_LEVEL=info
ELIZA_BASE_URL=http://127.0.0.1:7070

# Firebase Admin (optional if backend/serviceaccount.json exists)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Eliza Agent ---
ELIZA_PORT=7070
NOSANA_BASE_URL=https://inference-api.nosana.ai/v1
NOSANA_MODEL=Qwen/Qwen3.5-27B-AWQ-4bit
# Optional if Nosana endpoint is open/free for the selected model.
NOSANA_API_KEY=

# Optional: choose which character definition to boot with your runtime wrapper.
ELIZA_CHARACTER=characters/noogler.json
